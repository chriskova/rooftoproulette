rules_version = '2';
// Rooftop Roulette: paste into Firebase console > Firestore > Rules.
service cloud.firestore {
  match /databases/{db}/documents {
    // your profile and tab backup: only you
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /crawls/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid && request.resource.data.j.size() < 400000;
      }
      // invites: a mate (any signed-in person) can drop one in; only you read or clear them
      match /invites/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['from','fromUid','at']) && request.resource.data.from.size() < 40;
      }
    }
    // early-access list (the signup page at rooftoproulette.com): anyone can add themselves; nobody can read, change or list it from the web.
    // Read it in the Firebase console (Firestore > Data > waitlist).
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email','phone','src'])
        && request.resource.data.email is string && request.resource.data.email.size() < 120
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.phone in ['iphone','android']
        && request.resource.data.get('src','') is string && request.resource.data.get('src','').size() < 40;
    }
    // live crawls: anyone with the link (a random id) reads; the spinner writes the crawl;
    // followers can only add themselves (and ping the spinner from their own entry), take over when the spinner's
    // gone quiet for 2.5 minutes or hasn't answered their ping for 4 seconds, or be handed the spin
    match /live/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid && request.resource.data.g.size() < 200000;
      allow update: if request.auth != null && request.resource.data.g.size() < 200000 && request.resource.data.get('rec','').size() < 400000 && (
        resource.data.host == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
        || (request.resource.data.host == request.auth.uid && request.time.toMillis() - resource.data.beat > 150000
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['host','hostName','beat','prevHost','members']))
        || (request.resource.data.host == request.auth.uid
            && resource.data.members[request.auth.uid].get('ping', 0) > 0
            && resource.data.get('pongs', {}).get(request.auth.uid, 0) != resource.data.members[request.auth.uid].ping
            && request.time.toMillis() - resource.data.members[request.auth.uid].ping > 4000
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['host','hostName','beat','prevHost','members']))
      );
    }
  }
}
