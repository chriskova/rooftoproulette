<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and phone-to-phone transfer keep My Tab, settings and lists; spin clips stay out (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/Default/IndexedDB/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/Default/IndexedDB/" />
    </device-transfer>
</data-extraction-rules>
